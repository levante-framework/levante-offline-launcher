# Same-origin URLs so BrowserStack Local's bs-local.com rewrite stays a secure context
# (HTTPS preview) and can talk to the emulator + bundle server through Vite's preview proxy.
VITE_FUNCTIONS_BASE=/fn/demo-levante-spike/us-central1
VITE_AUTH_SIGNIN_URL=/auth-emu/identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key=demo
VITE_ASSET_BUCKET=levante-assets-prod
VITE_BUNDLE_BASE=/bundles
