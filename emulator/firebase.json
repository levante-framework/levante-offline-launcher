{
  "functions": [
    {
      "source": "../functions-repo/functions/levante-admin",
      "codebase": "levante-admin",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "auth": {
      "port": 9199
    },
    "functions": {
      "port": 5002
    },
    "firestore": {
      "port": 8180
    },
    "hub": {
      "port": 4401
    },
    "ui": {
      "enabled": true,
      "port": 4001
    },
    "singleProjectMode": true
  }
}